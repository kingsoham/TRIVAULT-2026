APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./app.db

# Secrets (Generate before running the application)
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JWT Secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FERNET_ENCRYPTION_KEY=replace_with_a_valid_base64_32byte_fernet_key_from_cryptography

STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
