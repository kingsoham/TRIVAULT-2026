# TriVault Root Environment Template
# Copy this file to .env in backend/ and frontend/ as described in documentation

# Backend Configurations (backend/.env)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./app.db

# Security & Secrets (Generate unique 32+ char secrets using scripts or openssl)
# Generate FERNET_ENCRYPTION_KEY using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate JWT_SECRET_KEY using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FERNET_ENCRYPTION_KEY=replace_with_a_valid_base64_32byte_fernet_key_from_cryptography

# Storage Settings
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=26214400 # 25MB limit

# Allowed Frontend Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configurations (frontend/.env)
# VITE_API_BASE_URL=http://127.0.0.1:8000
